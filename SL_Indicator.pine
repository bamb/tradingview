//@version=5
indicator("SL Size Indicator", shorttitle="SL Size", overlay=true)

// ========== INPUT PARAMETERS ==========

group_tf = "Timeframe Settings"
use_custom_tf = input.bool(false, "Use Custom Timeframe", group=group_tf, tooltip="When disabled, uses the chart's timeframe.\nWhen enabled, uses the custom timeframe below.")
custom_tf = input.timeframe("60", "Custom Timeframe", group=group_tf, tooltip="Timeframe for SL candle data (e.g. 1, 5, 15, 60, 240, D, W)")

group_main = "Main Settings"
sl_mode = input.string("Both", "SL Display Mode", options=["Long", "Short", "Both", "Auto"], group=group_main, tooltip="Long: SL below prev candle low\nShort: SL above prev candle high\nBoth: show both directions\nAuto: detect direction from prev candle body/wick ratio")
entry_source = input.string("Current Price", "Entry Price Source", options=["Current Price", "Candle Open"], group=group_main, tooltip="Current Price: updates live with every tick\nCandle Open: fixed at current candle open")
display_unit = input.string("Points", "Display Unit", options=["Points", "Ticks", "Cash"], group=group_main, tooltip="Points: price difference\nTicks: number of ticks\nCash: monetary value per contract")
sl_offset = input.float(0.0, "SL Offset (points)", minval=0.0, step=0.25, group=group_main, tooltip="Additional buffer added to SL beyond the prev candle high/low")

group_auto = "Auto Direction"
body_strong_ratio = input.float(0.66, "Strong Body Ratio", minval=0.1, maxval=0.95, step=0.05, group=group_auto, tooltip="Body > this ratio of total range = STRONG signal (default 2/3)")
body_weak_ratio = input.float(0.33, "Weak Body Ratio", minval=0.05, maxval=0.9, step=0.05, group=group_auto, tooltip="Body between weak and strong = WEAK signal\nBody < this ratio = DOJI / no signal (default 1/3)")
auto_doji_mode = input.string("Both", "Doji/No Signal Mode", options=["Both", "None"], group=group_auto, tooltip="What to show when candle body is too small:\nBoth: show both directions\nNone: hide SL/TP")

group_rr = "Risk : Reward"
show_rr = input.bool(true, "Show R:R & TP Levels", group=group_rr)
rr_ratio = input.float(2.0, "R:R Ratio", minval=0.5, maxval=10.0, step=0.5, group=group_rr, tooltip="Reward to Risk ratio (e.g. 2.0 = TP is 2x the SL distance)")

group_risk = "Account Risk"
show_account_risk = input.bool(true, "Show Account Risk %", group=group_risk)
account_size = input.float(10000.0, "Account Size ($)", minval=100.0, step=500.0, group=group_risk)
max_risk_pct = input.float(2.0, "Max Risk % (warning)", minval=0.1, maxval=50.0, step=0.5, group=group_risk, tooltip="Risk % above this will be highlighted as warning")

group_maxsl = "Max SL Filter"
enable_max_sl = input.bool(true, "Enable Max SL Filter", group=group_maxsl)
max_sl_ticks = input.float(40.0, "Max SL (ticks)", minval=1.0, step=1.0, group=group_maxsl, tooltip="SL above this value triggers a warning")
enable_sl_alert = input.bool(true, "Enable SL Alert", group=group_maxsl, tooltip="Trigger TradingView alert when SL exceeds max")

group_cash = "Cash Calculation"
contracts = input.int(1, "Number of Contracts", minval=1, group=group_cash, tooltip="Used for Cash display mode and risk calculations")
manual_tick_value = input.float(0.0, "Manual Tick Value ($)", minval=0.0, step=0.25, group=group_cash, tooltip="Override auto-detected tick value. Set to 0 for auto-detect")

group_table = "Table Settings"
table_position = input.string("Top Right", "Table Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=group_table)
table_size = input.string("Normal", "Table Size", options=["Small", "Normal", "Large"], group=group_table)
color_bull = input.color(color.new(color.green, 0), "Long SL Color", group=group_table)
color_bear = input.color(color.new(color.red, 0), "Short SL Color", group=group_table)
color_warning = input.color(color.new(color.orange, 0), "Warning Color", group=group_table)
color_danger = input.color(color.new(color.red, 0), "Danger Color", group=group_table)
table_bg_color = input.color(color.new(color.black, 30), "Table Background", group=group_table)
table_text_color = input.color(color.white, "Table Text Color", group=group_table)

// ========== POSITION MAPPING ==========

get_table_position(pos) =>
    switch pos
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        "Top Right" => position.top_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right" => position.middle_right
        "Bottom Left" => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right" => position.bottom_right

get_text_size(s) =>
    switch s
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large

// ========== TICK VALUE DETECTION ==========

get_tick_value() =>
    if manual_tick_value > 0
        manual_tick_value
    else
        syminfo.mintick * syminfo.pointvalue

tick_val = get_tick_value()

// ========== TIMEFRAME RESOLUTION ==========

tf = use_custom_tf ? custom_tf : timeframe.period

// Fetch candle data from selected timeframe using request.security
[tf_open, tf_close, tf_high_1, tf_low_1, tf_open_1, tf_close_1] = request.security(syminfo.tickerid, tf, [open, close, high[1], low[1], open[1], close[1]], lookahead=barmerge.lookahead_on)

// ========== CANDLE ANALYSIS ==========

prev_high = tf_high_1
prev_low = tf_low_1
prev_open = tf_open_1
prev_close = tf_close_1
entry_price = entry_source == "Current Price" ? tf_close : tf_open

// Previous candle body and range
prev_range = prev_high - prev_low
prev_body = math.abs(prev_close - prev_open)
body_ratio = prev_range > 0 ? prev_body / prev_range : 0.0
is_bullish_candle = prev_close > prev_open
is_bearish_candle = prev_close < prev_open

// Candle strength classification
is_strong = body_ratio >= body_strong_ratio
is_weak = body_ratio >= body_weak_ratio and body_ratio < body_strong_ratio
is_doji = body_ratio < body_weak_ratio

// Auto direction resolution
auto_show_long = false
auto_show_short = false
candle_signal = "DOJI"
candle_signal_color = color.gray

if sl_mode == "Auto"
    if is_strong and is_bullish_candle
        auto_show_long := true
        candle_signal := "STRONG BULL"
        candle_signal_color := color.lime
    else if is_strong and is_bearish_candle
        auto_show_short := true
        candle_signal := "STRONG BEAR"
        candle_signal_color := color.red
    else if is_weak and is_bullish_candle
        auto_show_long := true
        candle_signal := "WEAK BULL"
        candle_signal_color := color.new(color.green, 40)
    else if is_weak and is_bearish_candle
        auto_show_short := true
        candle_signal := "WEAK BEAR"
        candle_signal_color := color.new(color.red, 40)
    else
        // Doji / indecision
        candle_signal := "DOJI"
        candle_signal_color := color.gray
        if auto_doji_mode == "Both"
            auto_show_long := true
            auto_show_short := true

// Resolve final display flags
show_long = sl_mode == "Long" or sl_mode == "Both" or (sl_mode == "Auto" and auto_show_long)
show_short = sl_mode == "Short" or sl_mode == "Both" or (sl_mode == "Auto" and auto_show_short)

// SL in points
sl_long_points = entry_price - prev_low + sl_offset
sl_short_points = prev_high - entry_price + sl_offset

// SL in ticks
sl_long_ticks = sl_long_points / syminfo.mintick
sl_short_ticks = sl_short_points / syminfo.mintick

// SL in cash
sl_long_cash = sl_long_ticks * tick_val * contracts
sl_short_cash = sl_short_ticks * tick_val * contracts

// ========== R:R & TP CALCULATIONS ==========

// TP levels
tp_long_level = entry_price + sl_long_points * rr_ratio
tp_short_level = entry_price - sl_short_points * rr_ratio

// TP in cash
tp_long_cash = sl_long_cash * rr_ratio
tp_short_cash = sl_short_cash * rr_ratio

// ========== ACCOUNT RISK CALCULATIONS ==========

risk_long_pct = (sl_long_cash / account_size) * 100
risk_short_pct = (sl_short_cash / account_size) * 100

// ========== MAX SL FILTER ==========

sl_long_exceeded = enable_max_sl and sl_long_ticks > max_sl_ticks
sl_short_exceeded = enable_max_sl and sl_short_ticks > max_sl_ticks

// ========== FORMAT VALUES ==========

format_value(val_points, val_ticks, val_cash) =>
    switch display_unit
        "Points" => str.tostring(val_points, "#.##") + " pts"
        "Ticks" => str.tostring(val_ticks, "#.#") + " ticks"
        "Cash" => "$" + str.tostring(val_cash, "#.##")

long_text = format_value(sl_long_points, sl_long_ticks, sl_long_cash)
short_text = format_value(sl_short_points, sl_short_ticks, sl_short_cash)

// Risk % color helper
risk_color(pct) =>
    pct > max_risk_pct ? color_danger : pct > max_risk_pct * 0.75 ? color_warning : color.new(color.green, 0)

// SL exceeded color helper
sl_status_color(exceeded) =>
    exceeded ? color_danger : color.new(color.green, 0)

sl_status_text(exceeded) =>
    exceeded ? "SL TOO BIG" : "OK"

// ========== INSTRUMENT INFO ==========

tf_display = use_custom_tf ? ("TF: " + custom_tf) : ("TF: " + timeframe.period)
instrument_info = syminfo.ticker + " | " + tf_display + " | Tick: " + str.tostring(syminfo.mintick) + " | TickVal: $" + str.tostring(tick_val, "#.##")

// ========== DYNAMIC TABLE SIZE ==========

// Calculate number of columns needed
total_cols = 3 + (show_rr ? 1 : 0) + (show_account_risk ? 1 : 0) + (enable_max_sl ? 1 : 0)
// Rows: header(0) + info(1) + signal(2 if Auto) + col_headers + long + short
has_signal_row = sl_mode == "Auto"
total_rows = has_signal_row ? 7 : 6

// ========== TABLE DISPLAY ==========

var tbl = table.new(get_table_position(table_position), 7, total_rows, border_width=1, border_color=color.gray, frame_width=2, frame_color=color.gray)

txt_size = get_text_size(table_size)

if barstate.islast
    // --- Header row ---
    table.cell(tbl, 0, 0, "SL Size Indicator", bgcolor=color.new(color.blue, 40), text_color=table_text_color, text_size=txt_size, text_halign=text.align_center)
    table.merge_cells(tbl, 0, 0, total_cols - 1, 0)

    // --- Instrument info row ---
    table.cell(tbl, 0, 1, instrument_info, bgcolor=table_bg_color, text_color=color.new(color.white, 30), text_size=size.small, text_halign=text.align_center)
    table.merge_cells(tbl, 0, 1, total_cols - 1, 1)

    // --- Signal row (Auto mode only) ---
    row_offset = 2
    if has_signal_row
        body_pct_text = str.tostring(body_ratio * 100, "#.#") + "%"
        signal_full_text = candle_signal + " | Body: " + body_pct_text + " of range"
        table.cell(tbl, 0, row_offset, signal_full_text, bgcolor=color.new(candle_signal_color, 70), text_color=candle_signal_color, text_size=txt_size, text_halign=text.align_center)
        table.merge_cells(tbl, 0, row_offset, total_cols - 1, row_offset)
        row_offset += 1

    // --- Column headers ---
    col = 0
    table.cell(tbl, col, row_offset, "Direction", bgcolor=color.new(color.gray, 60), text_color=table_text_color, text_size=txt_size, text_halign=text.align_center)
    col += 1
    table.cell(tbl, col, row_offset, "SL Distance", bgcolor=color.new(color.gray, 60), text_color=table_text_color, text_size=txt_size, text_halign=text.align_center)
    col += 1
    table.cell(tbl, col, row_offset, "Entry → SL", bgcolor=color.new(color.gray, 60), text_color=table_text_color, text_size=txt_size, text_halign=text.align_center)

    rr_col = -1
    if show_rr
        col += 1
        rr_col := col
        table.cell(tbl, col, row_offset, "TP (" + str.tostring(rr_ratio, "#.#") + "R)", bgcolor=color.new(color.gray, 60), text_color=table_text_color, text_size=txt_size, text_halign=text.align_center)

    risk_col = -1
    if show_account_risk
        col += 1
        risk_col := col
        table.cell(tbl, col, row_offset, "Risk %", bgcolor=color.new(color.gray, 60), text_color=table_text_color, text_size=txt_size, text_halign=text.align_center)

    maxsl_col = -1
    if enable_max_sl
        col += 1
        maxsl_col := col
        table.cell(tbl, col, row_offset, "Filter", bgcolor=color.new(color.gray, 60), text_color=table_text_color, text_size=txt_size, text_halign=text.align_center)

    long_row = row_offset + 1
    short_row = row_offset + 2

    // --- LONG ROW ---
    if show_long
        entry_sl_long = str.tostring(entry_price, "#.##") + " → " + str.tostring(prev_low - sl_offset, "#.##")
        long_bg = sl_long_exceeded ? color.new(color_danger, 80) : table_bg_color
        long_dir_text = sl_mode == "Auto" and is_weak and is_bullish_candle ? "LONG ▲ ?" : "LONG ▲"

        table.cell(tbl, 0, long_row, long_dir_text, bgcolor=color.new(color_bull, 70), text_color=color_bull, text_size=txt_size, text_halign=text.align_center)
        table.cell(tbl, 1, long_row, long_text, bgcolor=long_bg, text_color=color_bull, text_size=txt_size, text_halign=text.align_center)
        table.cell(tbl, 2, long_row, entry_sl_long, bgcolor=long_bg, text_color=table_text_color, text_size=txt_size, text_halign=text.align_center)

        if show_rr and rr_col >= 0
            tp_text = str.tostring(tp_long_level, "#.##") + "\n$" + str.tostring(tp_long_cash, "#.##")
            table.cell(tbl, rr_col, long_row, tp_text, bgcolor=long_bg, text_color=color.new(color.aqua, 0), text_size=txt_size, text_halign=text.align_center)

        if show_account_risk and risk_col >= 0
            risk_txt = str.tostring(risk_long_pct, "#.##") + "%"
            table.cell(tbl, risk_col, long_row, risk_txt, bgcolor=long_bg, text_color=risk_color(risk_long_pct), text_size=txt_size, text_halign=text.align_center)

        if enable_max_sl and maxsl_col >= 0
            table.cell(tbl, maxsl_col, long_row, sl_status_text(sl_long_exceeded), bgcolor=long_bg, text_color=sl_status_color(sl_long_exceeded), text_size=txt_size, text_halign=text.align_center)
    else
        for c = 0 to total_cols - 1
            table.cell(tbl, c, long_row, "", bgcolor=table_bg_color, text_size=txt_size)

    // --- SHORT ROW ---
    if show_short
        entry_sl_short = str.tostring(entry_price, "#.##") + " → " + str.tostring(prev_high + sl_offset, "#.##")
        short_bg = sl_short_exceeded ? color.new(color_danger, 80) : table_bg_color
        short_dir_text = sl_mode == "Auto" and is_weak and is_bearish_candle ? "SHORT ▼ ?" : "SHORT ▼"

        table.cell(tbl, 0, short_row, short_dir_text, bgcolor=color.new(color_bear, 70), text_color=color_bear, text_size=txt_size, text_halign=text.align_center)
        table.cell(tbl, 1, short_row, short_text, bgcolor=short_bg, text_color=color_bear, text_size=txt_size, text_halign=text.align_center)
        table.cell(tbl, 2, short_row, entry_sl_short, bgcolor=short_bg, text_color=table_text_color, text_size=txt_size, text_halign=text.align_center)

        if show_rr and rr_col >= 0
            tp_text = str.tostring(tp_short_level, "#.##") + "\n$" + str.tostring(tp_short_cash, "#.##")
            table.cell(tbl, rr_col, short_row, tp_text, bgcolor=short_bg, text_color=color.new(color.aqua, 0), text_size=txt_size, text_halign=text.align_center)

        if show_account_risk and risk_col >= 0
            risk_txt = str.tostring(risk_short_pct, "#.##") + "%"
            table.cell(tbl, risk_col, short_row, risk_txt, bgcolor=short_bg, text_color=risk_color(risk_short_pct), text_size=txt_size, text_halign=text.align_center)

        if enable_max_sl and maxsl_col >= 0
            table.cell(tbl, maxsl_col, short_row, sl_status_text(sl_short_exceeded), bgcolor=short_bg, text_color=sl_status_color(sl_short_exceeded), text_size=txt_size, text_halign=text.align_center)
    else
        for c = 0 to total_cols - 1
            table.cell(tbl, c, short_row, "", bgcolor=table_bg_color, text_size=txt_size)

// ========== ALERTS ==========

long_alert = enable_sl_alert and sl_long_exceeded and show_long
short_alert = enable_sl_alert and sl_short_exceeded and show_short

// alertcondition requires const string — use static messages for UI-based alerts
alertcondition(long_alert, title="Long SL Too Big", message="LONG SL exceeds maximum! Check chart for details.")
alertcondition(short_alert, title="Short SL Too Big", message="SHORT SL exceeds maximum! Check chart for details.")

// alert() accepts series string — use for dynamic messages with actual values
if long_alert
    alert("LONG SL TOO BIG: " + str.tostring(sl_long_ticks, "#.#") + " ticks (max: " + str.tostring(max_sl_ticks, "#.#") + ") | Risk: " + str.tostring(risk_long_pct, "#.##") + "% | " + syminfo.ticker, alert.freq_once_per_bar)
if short_alert
    alert("SHORT SL TOO BIG: " + str.tostring(sl_short_ticks, "#.#") + " ticks (max: " + str.tostring(max_sl_ticks, "#.#") + ") | Risk: " + str.tostring(risk_short_pct, "#.##") + "% | " + syminfo.ticker, alert.freq_once_per_bar)

// ========== OPTIONAL: SL & TP LEVEL LINES ==========

group_lines = "SL Level Lines"
show_sl_lines = input.bool(true, "Show SL Lines on Chart", group=group_lines)
show_tp_lines = input.bool(true, "Show TP Lines on Chart", group=group_lines)
show_50_line = input.bool(true, "Show 50% Candle Level", group=group_lines, tooltip="Show the 50% level of the previous candle")
color_50 = input.color(color.new(color.yellow, 0), "50% Level Color", group=group_lines)
line_style_input = input.string("Dashed", "Line Style", options=["Solid", "Dashed", "Dotted"], group=group_lines)
line_width_input = input.int(1, "Line Width", minval=1, maxval=4, group=group_lines)

get_line_style(s) =>
    switch s
        "Solid" => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted

var line sl_long_line = na
var line sl_short_line = na
var line entry_line = na
var line tp_long_line = na
var line tp_short_line = na
var line mid_50_line = na

// Labels
var label sl_long_label = na
var label sl_short_label = na
var label tp_long_label = na
var label tp_short_label = na
var label entry_label = na
var label mid_50_label = na

if barstate.islast
    // Clean up old objects
    if not na(sl_long_line)
        line.delete(sl_long_line)
    if not na(sl_short_line)
        line.delete(sl_short_line)
    if not na(entry_line)
        line.delete(entry_line)
    if not na(tp_long_line)
        line.delete(tp_long_line)
    if not na(tp_short_line)
        line.delete(tp_short_line)
    if not na(sl_long_label)
        label.delete(sl_long_label)
    if not na(sl_short_label)
        label.delete(sl_short_label)
    if not na(tp_long_label)
        label.delete(tp_long_label)
    if not na(tp_short_label)
        label.delete(tp_short_label)
    if not na(entry_label)
        label.delete(entry_label)
    if not na(mid_50_line)
        line.delete(mid_50_line)
    if not na(mid_50_label)
        label.delete(mid_50_label)

    lstyle = get_line_style(line_style_input)
    bars_back = 5
    bars_forward = 10

    if show_sl_lines
        // Entry level line
        entry_line := line.new(bar_index - bars_back, entry_price, bar_index + bars_forward, entry_price, color=color.new(color.white, 40), style=lstyle, width=line_width_input)
        entry_label := label.new(bar_index + bars_forward, entry_price, "Entry " + str.tostring(entry_price, "#.##"), style=label.style_label_left, color=color.new(color.white, 80), textcolor=color.white, size=size.small)

        // Long SL line
        if show_long
            sl_long_level = prev_low - sl_offset
            sl_color_l = sl_long_exceeded ? color_danger : color_bull
            sl_long_line := line.new(bar_index - bars_back, sl_long_level, bar_index + bars_forward, sl_long_level, color=sl_color_l, style=lstyle, width=line_width_input)
            sl_long_label := label.new(bar_index + bars_forward, sl_long_level, "SL Long " + str.tostring(sl_long_level, "#.##"), style=label.style_label_left, color=color.new(sl_color_l, 80), textcolor=sl_color_l, size=size.small)

        // Short SL line
        if show_short
            sl_short_level = prev_high + sl_offset
            sl_color_s = sl_short_exceeded ? color_danger : color_bear
            sl_short_line := line.new(bar_index - bars_back, sl_short_level, bar_index + bars_forward, sl_short_level, color=sl_color_s, style=lstyle, width=line_width_input)
            sl_short_label := label.new(bar_index + bars_forward, sl_short_level, "SL Short " + str.tostring(sl_short_level, "#.##"), style=label.style_label_left, color=color.new(sl_color_s, 80), textcolor=sl_color_s, size=size.small)

    // TP lines
    if show_tp_lines and show_rr
        if show_long
            tp_long_line := line.new(bar_index - bars_back, tp_long_level, bar_index + bars_forward, tp_long_level, color=color.new(color.aqua, 30), style=lstyle, width=line_width_input)
            tp_long_label := label.new(bar_index + bars_forward, tp_long_level, "TP Long " + str.tostring(tp_long_level, "#.##"), style=label.style_label_left, color=color.new(color.aqua, 80), textcolor=color.aqua, size=size.small)

        if show_short
            tp_short_line := line.new(bar_index - bars_back, tp_short_level, bar_index + bars_forward, tp_short_level, color=color.new(color.aqua, 30), style=lstyle, width=line_width_input)
            tp_short_label := label.new(bar_index + bars_forward, tp_short_level, "TP Short " + str.tostring(tp_short_level, "#.##"), style=label.style_label_left, color=color.new(color.aqua, 80), textcolor=color.aqua, size=size.small)

    // 50% previous candle level
    if show_50_line
        mid_50_level = (prev_high + prev_low) / 2
        mid_50_line := line.new(bar_index - bars_back, mid_50_level, bar_index + bars_forward, mid_50_level, color=color_50, style=line.style_dotted, width=line_width_input)
        mid_50_label := label.new(bar_index + bars_forward, mid_50_level, "50% " + str.tostring(mid_50_level, "#.##"), style=label.style_label_left, color=color.new(color_50, 80), textcolor=color_50, size=size.small)
